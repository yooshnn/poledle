// Cloudflare Workers Static Assets: the built dist/ is served as is, with no Worker code.
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poledle",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "poledle.cupya.me", "custom_domain": true }],
  "workers_dev": false,
}
